name = "forms-{TENANT}"
compatibility_date = "2024-05-01"
compatibility_flags = ["nodejs_compat"]
pages_build_output_dir = "public"

# Replace IDs with output of:
#   wrangler d1 create forms-{TENANT}
#   wrangler kv:namespace create forms-{TENANT}-ratelimit

[[d1_databases]]
binding = "DB"
database_name = "forms-{TENANT}"
database_id = "REPLACE_WITH_D1_ID"
migrations_dir = "migrations"

[[kv_namespaces]]
binding = "RATE_LIMIT_KV"
id = "REPLACE_WITH_KV_ID"

[vars]
ALLOWED_ORIGINS = "https://example.com"
ENVIRONMENT = "production"
ADMIN_BASE_URL = "https://forms.{TENANT}.com"
# Secrets — set via:
#   wrangler pages secret put ADMIN_GITHUB_USERS   (comma-separated GitHub logins)
#   wrangler pages secret put GITHUB_CLIENT_ID
#   wrangler pages secret put GITHUB_CLIENT_SECRET
#   wrangler pages secret put SESSION_SECRET       (32+ random chars)
